@namespace GridWeb.Blazor
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
<div role="toolbar" aria-label="Spreadsheet commands" style="display:flex;flex-wrap:wrap;gap:.4rem;align-items:center;padding:.5rem">
    <button type="button" disabled="@(!Ready)" @onclick="Undo">Undo</button>
    <button type="button" disabled="@(!Ready)" @onclick="Redo">Redo</button>
    <button type="button" disabled="@(!Ready)" @onclick="Calculate">Calculate</button>
    <button type="button" disabled="@(!Ready || Editor!.ReadOnly)" @onclick="Bold">Bold</button>
    <button type="button" disabled="@(!Ready || Editor!.ReadOnly)" @onclick="Merge">Merge</button>
    <button type="button" disabled="@(!Ready || Editor!.ReadOnly)" @onclick="Unmerge">Unmerge</button>
    <button type="button" disabled="@(!Ready)" @onclick="RefreshPivots">Refresh pivots</button>
    <input aria-label="Cell or range address" @bind="Address" style="width:7rem" />
    <button type="button" disabled="@(!Ready)" @onclick="Select">Go</button>
    <input aria-label="Formula or cell input" @bind="Input" style="min-width:15rem;flex:1" />
    <button type="button" disabled="@(!Ready || Editor!.ReadOnly)" @onclick="Apply">Apply</button>
    @ChildContent
</div>
@code {
    [Parameter] public Spreadsheet? Editor { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<GridError> Error { get; set; }
    private string Address = "A1", Input = "";
    private bool Ready => Editor is { IsReady: true, Client: not null };
    private async Task Run(Func<Task> action) { try { if (Ready) await action(); } catch (Exception e) { if (!Error.HasDelegate) throw; await Error.InvokeAsync(new GridError(e.Message)); } }
    private Task Undo() => Run(async () => { await Editor!.FlushChangesAsync(); await Editor.Client!.UndoAsync(); });
    private Task Redo() => Run(async () => { await Editor!.FlushChangesAsync(); await Editor.Client!.RedoAsync(); });
    private Task Calculate() => Run(async () => { await Editor!.FlushChangesAsync(); await Editor.Client!.CalculateAsync(true); });
    private Task Bold() => Run(async () => { var s = await Editor!.GetSelectionAsync(); await Editor.Client!.GetRange(s.Address, s.Sheet).SetStyleAsync(new { font = new { bold = true } }); });
    private Task Merge() => Run(async () => { var s = await Editor!.GetSelectionAsync(); await Editor.Client!.GetRange(s.Address, s.Sheet).MergeAsync(); });
    private Task Unmerge() => Run(async () => { var s = await Editor!.GetSelectionAsync(); await Editor.Client!.GetRange(s.Address, s.Sheet).UnmergeAsync(); });
    private Task RefreshPivots() => Run(async () => { await Editor!.Client!.RefreshPivotsAsync(); });
    private Task Select() => Run(async () => { await Editor!.SelectAsync(Address); });
    private Task Apply() => Run(async () => { if (await Editor!.BeginEditAsync(Input) && !await Editor.CommitEditAsync()) throw new InvalidOperationException("Cell validation failed."); await Editor.FlushChangesAsync(); });
}
