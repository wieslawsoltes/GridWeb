{
  "name": "@wieslawsoltes/gridweb",
  "version": "0.3.0",
  "description": "Reusable spreadsheet engine, virtualized web control, MVVM/React adapters and .NET shared-engine hosts",
  "type": "module",
  "license": "MIT",
  "author": "GridWeb contributors",
  "main": "./src/core.js",
  "module": "./src/core.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": { "types": "./types/index.d.ts", "default": "./src/core.js" },
    "./controls": { "types": "./types/controls.d.ts", "default": "./src/controls.js" },
    "./io": { "types": "./types/io.d.ts", "default": "./src/io.js" },
    "./react": { "types": "./types/react.d.ts", "default": "./src/react.js" },
    "./worker": { "types": "./types/worker.d.ts", "default": "./src/worker.js" },
    "./host": { "types": "./types/host.d.ts", "default": "./src/host.js" },
    "./office": { "types": "./types/office.d.ts", "default": "./src/office.js" },
    "./printing": { "types": "./types/printing.d.ts", "default": "./src/layout.js" },
    "./browser": { "types": "./types/browser.d.ts", "default": "./src/browser.js" },
    "./package.json": "./package.json"
  },
  "files": ["src", "types", "dist", "docs", "examples", "dotnet", "README.md", "LICENSE", "NOTICE.md", "CHANGELOG.md"],
  "sideEffects": ["./src/controls.js", "./src/browser.js", "./dist/gridweb.js"],
  "engines": { "node": ">=22.16" },
  "repository": { "type": "git", "url": "git+https://github.com/wieslawsoltes/GridWeb.git" },
  "homepage": "https://wieslawsoltes.github.io/GridWeb/",
  "bugs": { "url": "https://github.com/wieslawsoltes/GridWeb/issues" },
  "keywords": ["spreadsheet", "excel", "formulas", "grid", "web-components", "react", "mvvm", "dotnet"],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit --strict --lib es2022,dom --module nodenext --moduleResolution nodenext tests/types.ts tests/references-types.ts tests/office-print-types.ts",
    "test:browser": "python tests/browser.py && python tests/features-browser.py",
    "test:package": "node scripts/package-test.mjs",
    "check": "npm test && npm run typecheck && npm run build && npm run test:package",
    "dev": "node scripts/serve.mjs",
    "release:pack": "npm run build && node scripts/release.mjs",
    "build:integrations": "node integrations/build.mjs"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "peerDependencies": { "react": "^18.3.0 || ^19.0.0" },
  "peerDependenciesMeta": { "react": { "optional": true } }
}
